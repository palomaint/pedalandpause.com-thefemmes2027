{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thefemmes-2027",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    "REGISTRATION_ENABLED": "false",
    "MAY_TIER": "first",
    "OCTOBER_TIER": "first"
  }
}
